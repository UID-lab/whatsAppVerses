# HTTPS front door for the whole app (used by docker-compose.https.yml).
# Caddy gets and renews a free Let's Encrypt certificate for SITE_DOMAIN automatically,
# redirects http:// to https://, and forwards everything to the frontend (nginx), which
# serves the React site and proxies /api to the backend.
#
# SITE_DOMAIN comes from .env, e.g. versesforjoy.duckdns.org
# (several names: "versesforjoy.duckdns.org, www.versesforjoy.duckdns.org").
{$SITE_DOMAIN} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	reverse_proxy frontend:80
}
