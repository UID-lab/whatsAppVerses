# ---------------------------------------------------------------------------------------------
# Backend environment. Copy to .env and adjust. Every variable is validated at boot.
# ---------------------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=log
# One JSON object per log line (recommended in production)
LOG_JSON=false
TRUST_PROXY_HOPS=1

# MySQL 8.0+ (or MariaDB 10.6+). utf8mb4 is required for Sanskrit text and emoji.
DATABASE_URL=mysql://verses:verses@localhost:3306/verses

# Browser origins allowed to call the API (comma-separated) and the public URL of the React app
CORS_ORIGINS=http://localhost:5173
PUBLIC_WEB_URL=http://localhost:5173

# Protects /api/admin/* — generate with: openssl rand -hex 24
ADMIN_API_KEY=change-me-to-a-long-random-string-0000

# ---- Subscribers ----
DEFAULT_PHONE_REGION=IN
# direct: subscribed as soon as the form is submitted; the welcome message is sent right away
# whatsapp_confirm: user must first send "JOIN <code>" to your number (lower ban risk, proves
#                   they own the number)
OPT_IN_MODE=direct
# When a subscriber has received every verse of their type (Gita: after ~23 months):
#   stop    = send nothing more, so a verse is never repeated (default)
#   restart = begin a new cycle
ON_VERSES_EXHAUSTED=stop
# Appears in the welcome message: "Thank you for subscribing to <BRAND_NAME>"
BRAND_NAME=U!D Labs
CONFIRM_CODE_TTL_HOURS=48

# ---- Scheduling (local time in APP_TIMEZONE) ----
# DAILY_SEND_TIME: when the daily verses start going out (24h HH:MM). The scheduler checks every
# 5 minutes, then sends at MESSAGES_PER_MINUTE. Keep SEND_WINDOW_START at or before this time.
APP_TIMEZONE=Asia/Kolkata
DAILY_SEND_TIME=07:00
SEND_WINDOW_START=07:00
SEND_WINDOW_END=21:30
ENQUEUE_BATCH_SIZE=1000
DELIVERY_RETENTION_DAYS=30

# ---- Sending ----
# baileys = real WhatsApp from your number; console = log messages only (development)
MESSAGING_PROVIDER=baileys
# The number messages are sent from (digits only, with country code)
WA_PHONE_NUMBER=918971775506
WA_SESSION_ID=primary
# all | api | sender  (see README "Scaling")
PROCESS_ROLE=all
# Keep these conservative on a personal number
MESSAGES_PER_MINUTE=6
DAILY_SEND_CAP=400
MAX_DELIVERY_ATTEMPTS=5
# A message that used all its attempts is marked FAILED, then automatically put back in the
# queue (every 10 minutes, same day) up to this many times. Not-on-WhatsApp numbers are skipped.
FAILED_REQUEUE_LIMIT=3
CLAIM_BATCH_SIZE=10
SIMULATE_TYPING=true
# Baileys' own log level (silent|error|warn|info|debug)
BAILEYS_LOG_LEVEL=warn
