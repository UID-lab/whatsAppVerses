# Non-secret settings for the docker-compose deployment (secrets come from ../.env).
NODE_ENV=production
PORT=3000
LOG_JSON=true
LOG_LEVEL=log
# Two proxies in front of the app: Caddy (or cloudflared) -> nginx -> backend
TRUST_PROXY_HOPS=2
DEFAULT_PHONE_REGION=IN
OPT_IN_MODE=direct
BRAND_NAME=U!D Labs
ON_VERSES_EXHAUSTED=stop
CONFIRM_CODE_TTL_HOURS=48
APP_TIMEZONE=Asia/Kolkata
# Defaults only: change the send time at runtime on /admin (stored in the database)
DAILY_SEND_TIME=21:30
SEND_WINDOW_START=07:00
SEND_WINDOW_END=23:00
MESSAGING_PROVIDER=baileys
WA_PHONE_NUMBER=918971775506
WA_SESSION_ID=primary
PROCESS_ROLE=all
MESSAGES_PER_MINUTE=6
DAILY_SEND_CAP=400
MAX_DELIVERY_ATTEMPTS=5
FAILED_REQUEUE_LIMIT=3
CLAIM_BATCH_SIZE=10
SIMULATE_TYPING=true
DELIVERY_RETENTION_DAYS=30
BAILEYS_LOG_LEVEL=warn
