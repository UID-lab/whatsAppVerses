# Used by docker-compose.yml. Copy to .env and change every value.
# Use URL-safe characters (letters/digits) — it is embedded in DATABASE_URL
MYSQL_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password
# openssl rand -hex 24
ADMIN_API_KEY=change-me-to-a-long-random-string-0000
# Public URL people use to open the site (used in unsubscribe links and CORS)
PUBLIC_WEB_URL=https://versesforjoy.duckdns.org

# HTTPS with Caddy + free Let's Encrypt certificate (see DEPLOY.md). Remove these two lines if
# you use a Cloudflare Tunnel instead.
COMPOSE_FILE=docker-compose.yml:docker-compose.https.yml
SITE_DOMAIN=versesforjoy.duckdns.org
# The site listens on WEB_BIND:WEB_PORT. 127.0.0.1 = reachable only from this server
# (Caddy or a Cloudflare Tunnel connects to it). Use 0.0.0.0 to expose the port directly.
WEB_BIND=127.0.0.1
WEB_PORT=8080
